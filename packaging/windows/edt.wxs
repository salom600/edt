<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX configuration for edt. Used by `cargo wix`.

  This is a minimal WiX file. `cargo wix init` can generate a more
  complete one; this serves as a starting point.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='edt'
    UpgradeCode='7B5A6C9D-3E1F-4A2B-9C8D-1E5F2A3B4C5D'
    Language='1033'
    Codepage='1252'
    Version='0.1.0'
    Manufacturer='salom600'>

    <Package Id='*'
      Description='edt video editor'
      Manufacturer='salom600'
      InstallerVersion='500'
      Languages='1033'
      Compressed='yes'
      SummaryCodepage='1252' />

    <Media Id='1' Cabinet='edt.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1' />
    <Property Id='DiskPrompt' Value='edt Installation [1]' />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder' Name='PFiles'>
        <Directory Id='APPLICATIONFOLDER' Name='edt'>
          <Component Id='MainExecutable' Guid='*'>
            <File Id='edt.exe' Name='edt.exe' DiskId='1' Source='target\release\edt.exe' KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>

      <Directory Id='ProgramMenuFolder'>
        <Directory Id='ProgramMenuDir' Name='edt'>
          <Component Id='ProgramMenuDir' Guid='*'>
            <RemoveFolder Id='ProgramMenuDir' On='uninstall' />
            <RegistryValue Root='HKCU' Key='Software\edt' Type='string' Value='' KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id='Complete' Level='1'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='ProgramMenuDir' />
    </Feature>

    <UI>
      <UIRef Id='WixUI_InstallDir' />
      <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER' />
    </UI>
  </Product>
</Wix>
